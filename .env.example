# ==========================================
# VoiceShield - Environment Configuration Example
# ==========================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
POSTGRES_USER=voiceshield_user
POSTGRES_PASSWORD=voiceshield_password
POSTGRES_DB=voiceshield_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://voiceshield_user:voiceshield_password@localhost:5432/voiceshield_db

# Backend Configuration (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:3000

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL_SEC=30

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# AI / Model Configuration (Placeholders for Future Models)
WHISPER_MODEL_SIZE=base
SPEAKER_VERIFICATION_MODEL_PATH=models/speaker_verification
AUDIO_SPOOF_MODEL_PATH=models/audio_spoof
OPENAI_API_KEY=your_openai_api_key_placeholder
