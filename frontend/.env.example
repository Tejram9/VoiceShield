# VoiceShield Frontend - Environment Configuration Example
# ========================================================

# Base HTTP URL of the FastAPI Backend
# Production example: https://api.voiceshield.example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base WebSocket URL (optional: if omitted, derived automatically from NEXT_PUBLIC_API_BASE_URL)
# Production example: wss://api.voiceshield.example.com
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
